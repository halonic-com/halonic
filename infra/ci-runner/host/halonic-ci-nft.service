[Unit]
Description=Halonic CI VM network rules (nft table inet halonic_ci)
# libvirtd requires this unit (RequiredBy= below): if the rules don't load, for example because
# /etc/halonic-ci/site.nft is missing, libvirtd doesn't start and the CI VM stays off.
After=network-pre.target
Before=libvirtd.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/halonic-ci/halonic-ci.nft
ExecReload=/usr/sbin/nft -f /etc/halonic-ci/halonic-ci.nft
# No ExecStop: stopping libvirtd doesn't stop the running VM, so the rules must stay. The file
# swaps the table atomically (its own `delete table`), and a load that fails keeps the old one.
# Remove the rules by hand (nft delete table inet halonic_ci) only with the VM shut down.

[Install]
WantedBy=multi-user.target
RequiredBy=libvirtd.service
