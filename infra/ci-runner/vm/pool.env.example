# /etc/halonic-ci/pool.env on the CI VM (root-owned), read by halonic-runner-slot.sh.
# Not secret, but site data: the real file isn't in the repo. The App's private key is a
# separate root-only 0400 file, /etc/halonic-ci/app.pem, and never goes in here.
APP_ID=
INSTALLATION_ID=
ORG=halonic-com
RUNNER_GROUP_ID=
IMAGE=halonic-ci-runner:2.338.2
