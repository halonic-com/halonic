[Unit]
Description=halonic-ci refresh of the fast slots' cache snapshot every 5 minutes (HAL-18424)
[Timer]
# Hourly was too stale: a fast pull request missed every typecheck and test entry a merge group had
# written in the last hour (HAL-18424). A reflink copy costs only metadata, so every 5 minutes.
OnCalendar=*:0/5
[Install]
WantedBy=timers.target
