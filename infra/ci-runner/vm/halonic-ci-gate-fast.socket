[Unit]
Description=halonic-ci gate socket for the fast pool (HAL-15972), pull request queries only

[Socket]
# Mounted read-only into fast slots only, at /run/halonic-ci-gate in the container. A socket of its
# own, so pull request jobs can't use up the merge-group jobs' 16 connections. A fast-track run
# starts about 12 jobs at once on the 10 fast slots, each asking at its start (up to 3 tries).
ListenStream=/run/halonic-ci-gate-fast/gate.sock
DirectoryMode=0755
SocketMode=0666
Accept=yes
MaxConnections=10
# At most 30 new connections a minute (systemd 255+), so at most 1800 of the read-only token's
# 5000 API calls an hour, which the merge queue's gate shares.
PollLimitIntervalSec=60s
PollLimitBurst=30

[Install]
WantedBy=sockets.target
