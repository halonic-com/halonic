[Unit]
Description=halonic-ci gate socket for the fast pool (HAL-15972), pull request queries only

[Socket]
# Mounted read-only into fast slots only, at /run/halonic-ci-gate in the container. A socket of its
# own, so pull request jobs can't use up the merge-group jobs' 16 connections. Every person's pull
# request runs here since HAL-17463: 40 fast slots since HAL-17574, each asking once at its job's
# start (a second and third time only when the gate failed), so one connection per slot.
ListenStream=/run/halonic-ci-gate-fast/gate.sock
DirectoryMode=0755
SocketMode=0666
Accept=yes
MaxConnections=40
# At most 48 new connections a minute (systemd 255+): all 40 slots starting a job in the same minute,
# plus 8 retries. Kept at 48 for 40 slots, because the calls follow the pull request jobs, not the
# slots, and a higher cap would eat the merge queue's share of the token. Expected: 25-30 pull request runs an hour x about 18 Linux jobs = about 540 calls an hour
# (9 a minute), 1620 if every job needed all 3 tries. The cap is 2880 an hour, which leaves at least
# 2120 of the read-only token's 5000 an hour for the merge queue's gate (one call per merge-group
# job, a few hundred an hour), even if a job does nothing but open connections here.
PollLimitIntervalSec=60s
PollLimitBurst=48

[Install]
WantedBy=sockets.target
