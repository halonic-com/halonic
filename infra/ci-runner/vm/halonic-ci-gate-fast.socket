[Unit]
Description=halonic-ci gate socket for the fast pool (HAL-15972), pull request queries only

[Socket]
# Mounted read-only into fast slots only, at /run/halonic-ci-gate in the container. A socket of its
# own, so pull request jobs can't use up the merge-group jobs' 16 connections.
ListenStream=/run/halonic-ci-gate-fast/gate.sock
DirectoryMode=0755
SocketMode=0666
Accept=yes
MaxConnections=4
# At most 10 new connections a minute (systemd 255+), so these jobs can't use up the read-only
# token's API limit that the merge queue's gate shares. A job asks once, at its start.
PollLimitIntervalSec=60s
PollLimitBurst=10

[Install]
WantedBy=sockets.target
