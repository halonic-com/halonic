[Unit]
Description=halonic-ci refresh of the fast slots' cache snapshot (HAL-16032, HAL-18424)
# Only once fast slots are deployed; without them there is nothing to refresh.
ConditionPathExists=/etc/halonic-ci/slots
[Service]
Type=oneshot
ExecCondition=/bin/grep -q halonic-runner@fast- /etc/halonic-ci/slots
# -n -E 0: skip this round (without failing) while the weekly cleanup or the hourly check runs:
# they may be emptying /cache/trusted, and the next round comes 5 minutes later anyway.
ExecStart=/usr/bin/flock -n -E 0 /run/lock/halonic-ci-maint.lock /usr/local/sbin/halonic-ci-fast-lower.sh refresh
SyslogIdentifier=halonic-ci-fast-lower
TimeoutStartSec=10min
