[Unit]
Description=halonic-ci gate socket for fast slot %i (HAL-15972), pull request queries only

[Socket]
# Mounted read-only into fast slot %i only, at /run/halonic-ci-gate in the container. A socket of
# its own, so pull request jobs can't use up the merge-group jobs' 16 connections, and one per slot
# (HAL-17473), so one job can't hold the connections every other fast job needs. A per-source limit
# can't do that: systemd 255 ignores MaxConnectionsPerSource= on a Unix socket, and later versions
# count by the peer's user ID, the same for every slot. A job asks once at its start (a second and
# third time only when the gate failed, one after the other), so 3 connections are plenty.
ListenStream=/run/halonic-ci-gate-fast/%i/gate.sock
DirectoryMode=0755
SocketMode=0666
Accept=yes
MaxConnections=3
# At most 3 new connections per 150 s per slot (systemd 255+): one job's three tries. With all 40
# fast slots installed (HAL-17574; fast-1..16 run normally since HAL-17616) that is at most 48 a
# minute, 2880 an hour (C7). Only fast-track pull requests run here (HAL-17616), a few runs an hour
# x about 18 Linux jobs. That leaves at least 2120 of the read-only token's 5000 an hour for the
# merge queue's gate (one call per merge-group job, a few hundred an hour), even if every fast job
# does nothing but open connections.
PollLimitIntervalSec=150s
PollLimitBurst=3

[Install]
WantedBy=sockets.target
