#!/usr/sbin/nft -f
# Windows runner VM network rules (host). Own table; never flushes ufw/docker/libvirt rules.
# The VM (bridge virbr-win, 10.79.0.0/24, static address 10.79.0.10, no DHCP) may reach only the
# internet on TCP 80/443, DNS on 1.1.1.1/1.0.0.1 and NTP. It can't reach the host (incl. its
# public IP and libvirt's dnsmasq), Paperclip, the Linux CI VM (10.77.0.0/24), Docker bridges,
# private/link-local/CGNAT ranges, or the server's public /24 (IPMI etc.).
# The host may open SSH to the VM (that's output, not forward); the VM's replies are let back in.
# /etc/halonic-ci/site.nft is shared with infra/ci-runner and holds one line,
#   define site_net4 = <the server's public /24>
include "/etc/halonic-ci/site.nft"
table inet halonic_win
delete table inet halonic_win
table inet halonic_win {
  set blocked4 {
    type ipv4_addr; flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
                 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15,
                 224.0.0.0/3, $site_net4 }
  }
  chain input {
    type filter hook input priority -10; policy accept;
    iifname "virbr-win" ct state established,related accept
    iifname "virbr-win" counter drop
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    oifname "virbr-win" ct state established,related accept
    oifname "virbr-win" counter drop
    iifname "virbr-win" meta nfproto ipv6 counter drop
    iifname "virbr-win" ip saddr != 10.79.0.10 counter drop
    iifname "virbr-win" ct state established,related accept
    iifname "virbr-win" ip daddr @blocked4 counter drop
    iifname "virbr-win" ip daddr { 1.1.1.1, 1.0.0.1 } meta l4proto { tcp, udp } th dport 53 accept
    iifname "virbr-win" udp dport 123 accept
    iifname "virbr-win" tcp dport { 80, 443 } accept
    iifname "virbr-win" counter drop
  }
}
