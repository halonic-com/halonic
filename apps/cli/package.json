{
  "name": "halonic",
  "private": true,
  "type": "module",
  "description": "The halonic command-line tool. Each command lives in its own folder under src/commands and the help is made from them.",
  "bin": {
    "halonic": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/adapter-env-secrets": "workspace:*",
    "@halonicjs/adapter-fs-node": "workspace:*",
    "@halonicjs/adapter-harness-claude-code": "workspace:*",
    "@halonicjs/adapter-harness-codex": "workspace:*",
    "@halonicjs/adapter-sandbox-host": "workspace:*",
    "@halonicjs/adapter-sandbox-srt": "workspace:*",
    "@halonicjs/adapter-system-node": "workspace:*",
    "@halonicjs/app": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/profile": "workspace:*",
    "@halonicjs/std": "workspace:*",
    "@halonicjs/workspace": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "apps",
    "owner": "liam",
    "coverage": {
      "lines": 90,
      "branches": 85
    },
    "discover": {
      "commands": {
        "folder": "src/commands",
        "file": "command.ts",
        "suffix": "Command",
        "satisfies": {
          "type": "CommandRegistry",
          "from": "src/command.ts"
        }
      }
    }
  }
}
