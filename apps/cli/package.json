{
  "name": "halonic",
  "private": true,
  "type": "module",
  "description": "The halonic command-line tool. Each command lives in its own folder under src/commands and the help is made from them.",
  "bin": {
    "halonic": "./bin/halonic.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run --config vitest.merge.config.ts --merge-reports=test-results/blob",
    "test:part-1": "vitest run --config vitest.part.config.ts --shard=1/2 --outputFile.blob=test-results/blob/part-1.json --coverage.reportsDirectory=coverage/part-1",
    "test:part-2": "vitest run --config vitest.part.config.ts --shard=2/2 --outputFile.blob=test-results/blob/part-2.json --coverage.reportsDirectory=coverage/part-2",
    "test:all": "vitest run",
    "test:fence": "vitest run --config vitest.fence.config.ts"
  },
  "dependencies": {
    "@halonicjs/action-catalog": "workspace:*",
    "@halonicjs/action-steppers": "workspace:*",
    "@halonicjs/adapter-agent-messaging-cache": "workspace:*",
    "@halonicjs/adapter-coding-tools": "workspace:*",
    "@halonicjs/adapter-connector-stdio-sandbox": "workspace:*",
    "@halonicjs/adapter-coordination-node": "workspace:*",
    "@halonicjs/adapter-doctor-node": "workspace:*",
    "@halonicjs/adapter-env-secrets": "workspace:*",
    "@halonicjs/adapter-fs-node": "workspace:*",
    "@halonicjs/adapter-git": "workspace:*",
    "@halonicjs/adapter-harness-bridge": "workspace:*",
    "@halonicjs/adapter-harness-claude-code": "workspace:*",
    "@halonicjs/adapter-harness-codex": "workspace:*",
    "@halonicjs/adapter-harness-opencode": "workspace:*",
    "@halonicjs/adapter-harness-kit": "workspace:*",
    "@halonicjs/adapter-http-kit": "workspace:*",
    "@halonicjs/adapter-http-node": "workspace:*",
    "@halonicjs/adapter-integration-runner": "workspace:*",
    "@halonicjs/adapter-mcp": "workspace:*",
    "@halonicjs/adapter-memory": "workspace:*",
    "@halonicjs/adapter-model-anthropic": "workspace:*",
    "@halonicjs/adapter-model-mock": "workspace:*",
    "@halonicjs/adapter-model-openai": "workspace:*",
    "@halonicjs/adapter-paperclip-client": "workspace:*",
    "@halonicjs/adapter-password-scrypt": "workspace:*",
    "@halonicjs/adapter-sandbox-host": "workspace:*",
    "@halonicjs/adapter-sandbox-srt": "workspace:*",
    "@halonicjs/adapter-scheduler-node": "workspace:*",
    "@halonicjs/adapter-secrets-file": "workspace:*",
    "@halonicjs/adapter-system-node": "workspace:*",
    "@halonicjs/adapter-token-store": "workspace:*",
    "@halonicjs/adapter-toolscript-quickjs-node": "workspace:*",
    "@halonicjs/adapter-workspace-engine-node": "workspace:*",
    "@halonicjs/adapter-workspace-models": "workspace:*",
    "@halonicjs/app": "workspace:*",
    "@halonicjs/auto-approvals": "workspace:*",
    "@halonicjs/engine": "workspace:*",
    "@halonicjs/events": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/google-setup": "workspace:*",
    "@halonicjs/host-google-sign-in": "workspace:*",
    "@halonicjs/host-agent-messaging-hub": "workspace:*",
    "@halonicjs/host-harness-host": "workspace:*",
    "@halonicjs/host-integration-sign-in": "workspace:*",
    "@halonicjs/host-server": "workspace:*",
    "@halonicjs/oauth-sign-in": "workspace:*",
    "@halonicjs/plugin-build": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/profile": "workspace:*",
    "@halonicjs/routines": "workspace:*",
    "@halonicjs/schema-kit": "workspace:*",
    "@halonicjs/std": "workspace:*",
    "@halonicjs/target-node-harness": "workspace:*",
    "@halonicjs/target-node-runtime": "workspace:*",
    "@halonicjs/target-paperclip-runtime": "workspace:*",
    "@halonicjs/test-runner": "workspace:*",
    "@halonicjs/words": "workspace:*",
    "@halonicjs/workflow": "workspace:*",
    "@halonicjs/workspace": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-parity": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "apps",
    "owner": "liam",
    "coverage": {
      "lines": 90,
      "branches": 85
    },
    "discover": {
      "commands": {
        "folder": "src/commands",
        "file": "command.ts",
        "suffix": "Command",
        "satisfies": {
          "type": "CommandRegistry",
          "from": "src/command.ts"
        }
      }
    }
  }
}
