{
  "name": "@halonicjs/app-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Studio app: wires the Studio packages and features together. The Tauri shell and its Android project live in src-tauri; Vite builds the Studio page (studio.html) and, apart from it, the Android app's own page (connect.html).",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "test": "vitest run",
    "build": "vite build && vite build --mode studio",
    "studio": "vite --mode studio"
  },
  "dependencies": {
    "@halonicjs/adapter-fs-tauri": "workspace:*",
    "@halonicjs/app": "workspace:*",
    "@halonicjs/events": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/schema-kit": "workspace:*",
    "@halonicjs/std": "workspace:*",
    "@halonicjs/studio-feature-inbox": "workspace:*",
    "@halonicjs/studio-feature-plugins": "workspace:*",
    "@halonicjs/studio-feature-runs": "workspace:*",
    "@halonicjs/studio-feature-settings": "workspace:*",
    "@halonicjs/studio-feature-workspace": "workspace:*",
    "@halonicjs/studio-services": "workspace:*",
    "@halonicjs/studio-shell": "workspace:*",
    "@halonicjs/workspace": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/adapter-fs-node": "workspace:*",
    "@halonicjs/adapter-memory": "workspace:*",
    "@halonicjs/engine": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/studio-kit": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "apps",
    "owner": "elena",
    "coverage": {
      "lines": 80
    }
  }
}
