{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halonic",
  "version": "0.1.0",
  "identifier": "com.halonic.studio",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run build",
      "wait": true
    },
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/studio"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Halonic",
        "url": "studio.html",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QjRGQ0IyQkZCRkQxODgKUldTSTBiKy9zdnkwMTFUSnVSbGdXWU5JSWZNK2k4K3BXS3YzNlo5TXUwc21tdXcrNXorSGRlUVMK",
      "endpoints": [
        "https://updates.halonic.com/{{track}}/{{target}}-{{arch}}/{{current_version}}"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
