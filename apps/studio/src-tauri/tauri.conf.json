{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halonic",
  "version": "0.1.0",
  "identifier": "com.halonic.studio",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run build",
      "wait": true
    },
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/studio"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Halonic",
        "url": "studio.html",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QTc3MTE2QzI5NUU0NzMKUldSejVKWENGbkduT0pPSXNCMTB6UDZnSmpRZFJNRHo5a1FVWEJwLzFFd0lpbjhqWEM3VlA2ckYK",
      "endpoints": [
        "https://github.com/halonic-com/halonic/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
