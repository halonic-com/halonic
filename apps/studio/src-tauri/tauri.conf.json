{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halonic",
  "version": "0.1.0",
  "identifier": "com.halonic.studio",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run build",
      "wait": true
    },
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/studio"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Halonic",
        "url": "studio.html",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
