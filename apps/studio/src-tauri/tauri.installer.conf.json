{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Halonic",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/halonic-agent-host"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "startMenuFolder": "Halonic",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
