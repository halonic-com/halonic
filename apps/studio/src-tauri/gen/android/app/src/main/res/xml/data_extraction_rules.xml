<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: allowBackup="false" stops the cloud backup but not a
     transfer to a new phone, so both exclude every data domain (HAL-6866). -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
