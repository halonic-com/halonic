{
  "name": "@halonicjs/app-agent-host",
  "private": true,
  "type": "module",
  "description": "Halonic's agent host as one Node program: it unpacks its files and serves on loopback with a token per launch.",
  "exports": {
    ".": "./src/index.ts",
    "./google-host": "./src/google-host.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build:sea": "pnpm --filter @halonicjs/adapter-integration-runner build && node scripts/build.ts",
    "smoke:sea": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "apps",
    "owner": "owen",
    "coverage": {
      "lines": 80
    }
  },
  "version": "0.0.0",
  "dependencies": {
    "@halonicjs/adapter-connector-stdio-sandbox": "workspace:*",
    "@halonicjs/adapter-env-secrets": "workspace:*",
    "@halonicjs/adapter-fs-node": "workspace:*",
    "@halonicjs/adapter-git": "workspace:*",
    "@halonicjs/adapter-harness-bridge": "workspace:*",
    "@halonicjs/adapter-harness-claude-code": "workspace:*",
    "@halonicjs/adapter-harness-codex": "workspace:*",
    "@halonicjs/adapter-harness-kit": "workspace:*",
    "@halonicjs/adapter-http-kit": "workspace:*",
    "@halonicjs/adapter-http-node": "workspace:*",
    "@halonicjs/adapter-integration-runner": "workspace:*",
    "@halonicjs/adapter-mcp": "workspace:*",
    "@halonicjs/adapter-model-mock": "workspace:*",
    "@halonicjs/adapter-model-openai": "workspace:*",
    "@halonicjs/adapter-memory": "workspace:*",
    "@halonicjs/adapter-remote-gateway": "workspace:*",
    "@halonicjs/adapter-sandbox-host": "workspace:*",
    "@halonicjs/adapter-sandbox-srt": "workspace:*",
    "@halonicjs/adapter-secrets-file": "workspace:*",
    "@halonicjs/adapter-system-node": "workspace:*",
    "@halonicjs/adapter-token-store": "workspace:*",
    "@halonicjs/app": "workspace:*",
    "@halonicjs/engine": "workspace:*",
    "@halonicjs/events": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/google-setup": "workspace:*",
    "@halonicjs/host-google-sign-in": "workspace:*",
    "@halonicjs/host-server": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/profile": "workspace:*",
    "@halonicjs/workspace": "workspace:*",
    "@halonicjs/schema-kit": "workspace:*",
    "@halonicjs/std": "workspace:*"
  }
}
