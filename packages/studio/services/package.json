{
  "name": "@halonicjs/studio-services",
  "private": true,
  "type": "module",
  "description": "The Studio's platform bridges: services that come from the shell the Studio runs in, such as the OS keychain in the desktop app.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/adapter-agent-host-client": "workspace:*",
    "@halonicjs/adapter-harness-claude-code": "workspace:*",
    "@halonicjs/adapter-harness-codex": "workspace:*",
    "@halonicjs/adapter-secrets-tauri": "workspace:*",
    "@halonicjs/app": "workspace:*",
    "@halonicjs/ports": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "studio",
    "owner": "priya",
    "coverage": {
      "lines": 100,
      "branches": 100
    }
  }
}
