{
  "extends": "@halonicjs/tooling-config/tsconfig/node.json",
  "//": "Tests run in Node, the frame's with jsdom, so they need Node's types and the DOM's, and JSX.",
  "compilerOptions": {
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "examples",
    "e2e",
    "vitest.config.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
