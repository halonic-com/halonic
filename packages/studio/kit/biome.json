{
  "$schema": "../../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**"
                    ],
                    "message": "Node APIs belong in Node adapters, the Node target and deploy packages. Use a port."
                  },
                  {
                    "group": [
                      "@halonicjs/adapter-*",
                      "@halonicjs/adapter-*/**"
                    ],
                    "message": "Adapters are for adapters and apps. Use a port from core."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
