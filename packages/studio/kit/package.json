{
  "name": "@halonicjs/studio-kit",
  "private": true,
  "type": "module",
  "description": "The Studio's design tokens (one theme.css) and, later, its shared base components.",
  "exports": {
    ".": {
      "style": "./src/theme.css",
      "default": "./src/index.ts"
    },
    "./fonts": {
      "style": "./src/theme-font.css"
    },
    "./app-glyphs": "./src/app-logo/app-glyphs.ts",
    "./list-column": "./src/list-column/list-column.ts",
    "./settle": "./src/settle/settle.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "states": "vite"
  },
  "dependencies": {
    "@halonicjs/openui-lang": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "jsqr": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "studio",
    "owner": "noah",
    "coverage": {
      "lines": 85
    }
  }
}
