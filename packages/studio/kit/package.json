{
  "name": "@halonicjs/studio-kit",
  "private": true,
  "type": "module",
  "description": "The Studio's design tokens (one theme.css) and, later, its shared base components.",
  "exports": {
    ".": {
      "style": "./src/theme.css",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "states": "vite"
  },
  "dependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "studio",
    "owner": "noah",
    "coverage": {
      "lines": 85
    }
  }
}
