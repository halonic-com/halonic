{
  "name": "@halonicjs/adapter-integration-runner",
  "private": true,
  "type": "module",
  "description": "The fenced integration runner's stdio bridge: the strict message protocol between Halonic and the runner process that holds one local integration.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node esbuild.config.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:fence": "vitest run --config vitest.fence.config.ts"
  },
  "dependencies": {
    "@halonicjs/adapter-integration-kit": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/schema-kit": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/adapter-sandbox-host": "workspace:*",
    "@halonicjs/adapter-sandbox-srt": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "ravi",
    "coverage": {
      "lines": 80
    },
    "runtime": "node"
  }
}
