{
  "name": "@halonicjs/adapter-system-node",
  "private": true,
  "type": "module",
  "description": "The ResourceProbe port on Node: the engine's memory, the processes below it from /proc, ps or PowerShell, folder sizes and free disk space.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/ports": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "owen",
    "runtime": "node",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
