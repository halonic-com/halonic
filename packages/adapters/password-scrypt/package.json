{
  "name": "@halonicjs/adapter-password-scrypt",
  "private": true,
  "type": "module",
  "description": "The PasswordHasher port with scrypt, for `serve`.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
