{
  "name": "@halonicjs/adapter-fs-tauri",
  "private": true,
  "type": "module",
  "description": "The TrustStore, RunStore, BlobStore, RecordStore and DefinitionStore ports over the Studio shell's trust_*, run_*, blob_*, record_* and fs_* commands, sharing the trust folder, the run, blob and record folders and the workspace files with the CLI and one opened-folder list with git.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/adapter-watch-kit": "workspace:*",
    "@halonicjs/events": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/profile": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "priya",
    "coverage": {
      "lines": 100,
      "branches": 100
    },
    "runtime": "web"
  }
}
