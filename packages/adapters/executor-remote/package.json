{
  "name": "@halonicjs/adapter-executor-remote",
  "private": true,
  "type": "module",
  "description": "The RunExecutor port against a Halonic host over HTTP: sign-in, run routes, a resumable event stream and chat turns, with fetch only.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "elena",
    "coverage": {
      "lines": 95,
      "branches": 90
    },
    "runtime": "any"
  },
  "dependencies": {
    "@halonicjs/events": "workspace:*",
    "@halonicjs/ports": "workspace:*"
  }
}
