{
  "name": "@halonicjs/adapter-env-secrets",
  "private": true,
  "type": "module",
  "description": "The Secrets port over HALONIC_SECRET_<NAME> environment variables, and firstSecret to chain stores.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/ports": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/adapter-memory": "workspace:*",
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "priya",
    "coverage": {
      "lines": 100,
      "branches": 100
    },
    "runtime": "any"
  }
}
