{
  "name": "@halonicjs/adapter-mcp",
  "private": true,
  "type": "module",
  "description": "Our own MCP client for local programs: the MCP protocol session, the stdio connector that starts a trusted program, and the pinned launcher for npx and uvx connectors.",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/protocol && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/adapter-system-node": "workspace:*",
    "@halonicjs/app": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/schema-kit": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/adapter-memory": "workspace:*",
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "tomas",
    "coverage": {
      "lines": 80
    },
    "runtime": "node"
  }
}
