{
  "name": "@halonicjs/adapter-sign-in-loopback",
  "private": true,
  "type": "module",
  "description": "The app's side of a sign-in: a loopback server on 127.0.0.1 for the flow's callback, and a launcher that starts a sign-in and opens the browser through a small port.",
