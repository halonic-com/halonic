{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/integration-kit/secret-placement/v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "minLength": 1
        },
        "as": {
          "type": "string",
          "const": "bearer"
        }
      },
      "required": [
        "secret",
        "as"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "minLength": 1
        },
        "as": {
          "type": "string",
          "const": "header"
        },
        "header": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "secret",
        "as",
        "header"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "minLength": 1
        },
        "as": {
          "type": "string",
          "const": "form"
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "secret",
        "as",
        "field"
      ],
      "additionalProperties": false
    }
  ]
}
