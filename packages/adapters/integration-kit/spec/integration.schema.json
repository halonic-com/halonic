{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/integration-kit/integration/v1.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "risk": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "send"
            ]
          },
          "untrusted": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "parameters",
          "risk"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "version",
    "tools"
  ],
  "additionalProperties": false
}
