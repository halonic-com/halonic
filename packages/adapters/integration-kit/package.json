{
  "name": "@halonicjs/adapter-integration-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The integration interface: the IntegrationHost an integration gets, with an HttpClient limited to the hosts and secrets of its permission sheet. Only its ./integration entry is published, as @halonicjs/integration-kit.",
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build": "node ../../../tooling/publish/src/cli/stage.ts ."
  },
  "dependencies": {
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@halonicjs/tooling-publish": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "liam",
    "runtime": "any",
    "coverage": {
      "lines": 80
    },
    "publish": {
      "name": "@halonicjs/integration-kit",
      "entry": "./integration",
      "description": "What an integration for Halonic imports: the port types, runTool and the errors the host raises. No dependencies.",
      "aliases": {},
      "dependencies": {},
      "peerDependencies": {}
    }
  }
}
