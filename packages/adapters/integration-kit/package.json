{
  "name": "@halonicjs/adapter-integration-kit",
  "private": true,
  "type": "module",
  "description": "The integration interface: the IntegrationHost an integration gets, with an HttpClient limited to the hosts and secrets of its permission sheet. Only its ./integration entry is published, as @halonicjs/adapters/integration-kit.",
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/adapter-http-kit": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/schema-kit": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "liam",
    "runtime": "any",
    "coverage": {
      "lines": 80
    },
    "publish": {
      "name": "@halonicjs/adapters/integration-kit",
      "entry": "./integration"
    }
  }
}
