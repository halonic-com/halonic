{
  "name": "@halonicjs/adapter-harness-kit",
  "private": true,
  "type": "module",
  "description": "What the harness adapters share: reading a program's output line by line, keeping the bridge token and anything after the final agent.finished out of a run's events, writing the agent's settings folder, naming a harness's install folders in a Windows profile, and building a harness run's sandbox profile.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/engine": "workspace:*",
    "@halonicjs/events": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/adapter-git": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "owen",
    "coverage": {
      "lines": 90,
      "branches": 85
    },
    "runtime": "node"
  }
}
