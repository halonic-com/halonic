{
  "name": "@halonicjs/adapter-toolscript-quickjs",
  "private": true,
  "type": "module",
  "description": "Runs a ToolScript in a fresh QuickJS (WASM) isolate per run.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build:engine": "bash engine/rebuild.sh"
  },
  "dependencies": {
    "@halonicjs/ports": "workspace:*",
    "quickjs-emscripten-core": "catalog:"
  },
  "devDependencies": {
    "@halonicjs/adapter-memory": "workspace:*",
    "@halonicjs/engine": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/testing-toolscript-fence": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "mateo",
    "coverage": {
      "lines": 80
    },
    "runtime": "any"
  }
}
