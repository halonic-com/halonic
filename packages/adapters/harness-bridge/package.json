{
  "name": "@halonicjs/adapter-harness-bridge",
  "private": true,
  "type": "module",
  "description": "The Halonic bridge for harness runs: a loopback server per run that passes model requests to the provider and serves Halonic's tools over MCP.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/events": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "owen",
    "coverage": {
      "lines": 90,
      "branches": 85
    },
    "runtime": "node"
  }
}
