{
  "name": "@halonicjs/adapter-agent-messaging-cache",
  "private": true,
  "type": "module",
  "description": "The AgentMessaging cache on the local file system with Node: it keeps what each read gave in private files outside every workspace, so an offline source still shows its items.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/adapter-fs-node": "workspace:*",
    "@halonicjs/ports": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "tomas",
    "coverage": {
      "lines": 80
    },
    "runtime": "node"
  }
}
