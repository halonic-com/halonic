{
  "name": "@halonicjs/adapter-cloudflare-durable",
  "private": true,
  "type": "module",
  "description": "The Coordination port in a Cloudflare Durable Object: leases, values, counters and login-limit windows.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@halonicjs/adapter-cloudflare-storage": "workspace:*",
    "@halonicjs/target-cloudflare-testing": "workspace:*",
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "priya",
    "coverage": {
      "lines": 90,
      "branches": 85
    },
    "runtime": "workers"
  },
  "dependencies": {
    "@halonicjs/events": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/std": "workspace:*"
  }
}
