{
  "name": "@halonicjs/adapter-user-secrets",
  "private": true,
  "type": "module",
  "description": "End-user secrets sealed under a per-user data key, which the deployment's key-encryption key wraps (AES-GCM through Web Crypto).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "mateo",
    "coverage": {
      "lines": 100,
      "branches": 100
    },
    "runtime": "any"
  },
  "dependencies": {
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/std": "workspace:*"
  }
}
