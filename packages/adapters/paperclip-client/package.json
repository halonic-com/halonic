{
  "name": "@halonicjs/adapter-paperclip-client",
  "private": true,
  "type": "module",
  "description": "The Paperclip provider behind AgentMessaging: reads agents, chats, cards and tasks over plain fetch, and hears live events over its own WebSocket client.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:board": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@halonicjs/action-steppers": "workspace:*",
    "@halonicjs/adapter-websocket-frames": "workspace:*",
    "@halonicjs/ports": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "adapters",
    "owner": "ravi",
    "coverage": {
      "lines": 80
    },
    "runtime": "node"
  }
}
