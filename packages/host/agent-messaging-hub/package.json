{
  "name": "@halonicjs/host-agent-messaging-hub",
  "private": true,
  "type": "module",
  "description": "The messaging hub that joins every AgentMessaging provider into one, and the guard that hands a Paperclip key only to a request for the address and company it was made for, on Web-standard APIs only.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
