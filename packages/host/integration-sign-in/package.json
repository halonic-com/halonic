{
  "name": "@halonicjs/host-integration-sign-in",
  "private": true,
  "type": "module",
  "description": "The host's side of an integration's sign-ins: the tokens the kit asks for, filled in from the permission sheet and the settings, and a sign-out that waits for a refresh in flight.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/format": "workspace:*",
    "@halonicjs/oauth-sign-in": "workspace:*",
    "@halonicjs/ports": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "host",
    "owner": "ravi",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
