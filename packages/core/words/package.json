{
  "name": "@halonicjs/words",
  "private": true,
  "type": "module",
  "description": "The sentences the CLI and Studio share, as parts a terminal or a page can draw: the phrase builder, the catalogue and the doctor's words.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/app": "workspace:*",
    "@halonicjs/ports": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "core",
    "owner": "liam",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
