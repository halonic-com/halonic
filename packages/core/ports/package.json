{
  "name": "@halonicjs/ports",
  "private": true,
  "type": "module",
  "description": "One file per port: the versioned interfaces that core logic depends on and adapters implement. Web types only.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "core",
    "owner": "liam",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
