{
  "name": "@halonicjs/workspace",
  "private": true,
  "type": "module",
  "description": "Loads one workspace through DefinitionSource: each file parsed by the kind its place gives, with every issue's file, key path and line, its trust content for the trust gate, and a new workspace laid out through DefinitionStore.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/routines": "workspace:*",
    "@halonicjs/std": "workspace:*",
    "@halonicjs/yaml": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-parity": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "core",
    "owner": "elena",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
