{
  "name": "@halonicjs/schema-kit",
  "private": true,
  "type": "module",
  "description": "Our thin layer over Zod: validation, TypeScript types derived from the schemas and JSON Schema export. Errors carry the path. The only package besides core/format that imports zod.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "core",
    "owner": "elena",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
