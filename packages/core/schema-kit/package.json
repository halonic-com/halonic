{
  "name": "@halonicjs/schema-kit",
  "private": true,
  "type": "module",
  "description": "Validation with TypeScript types derived from the schemas and JSON Schema export; replaces Zod. Errors carry the path.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "core",
    "owner": "elena"
  }
}
