              }
            ]
          },
          "review": {
            "type": "wait",
            "description": "A person approves the report or sends it back.",
            "on": [
              {
                "to": "done",
                "event": "approve"
              },
              {
                "to": "report",
                "event": "reject"
              }
            ]
          },
          "done": {
            "type": "final"
          }
        },
        "layout": {
          "classify": {
            "x": 160,
            "y": 0
          },
          "answer": {
            "x": 0,
            "y": 240
          },
          "report": {
            "x": 300,
            "y": 240
