            "y": 480
          }
        }
      }
    },
    {
      "name": "acme daily-digest routine",
      "rule": "example-file",
      "input": {
        "version": 1,
        "id": "daily-digest",
        "name": "Daily digest",
        "description": "Every weekday morning, a short note on what support should know today.",
        "enabled": false,
        "trigger": {
          "schedule": "0 8 * * 1-5",
          "timezone": "Europe/Amsterdam"
        },
        "run": {
          "agent": "support",
          "prompt": "Write a short digest for the support team for {{trigger.at}}.\nList the three handbook topics customers ask about most, with one tip each.\n"
        },
        "overlap": "skip",
        "catchUp": "last"
      },
      "output": {
        "version": 1,
        "id": "daily-digest",
        "name": "Daily digest",
        "description": "Every weekday morning, a short note on what support should know today.",
        "enabled": false,
        "trigger": {
          "schedule": "0 8 * * 1-5",
          "timezone": "Europe/Amsterdam"
        },
        "run": {
          "agent": "support",
          "prompt": "Write a short digest for the support team for {{trigger.at}}.\nList the three handbook topics customers ask about most, with one tip each.\n"
        },
        "overlap": "skip",
        "catchUp": "last"
      }
    }
  ]
}
