{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provides": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "connector",
          "llm",
          "knowledge"
        ]
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]*[a-z0-9])?(?::(?:[1-9]\\d{0,3}|[1-5]\\d{4}|6[0-4]\\d{3}|65[0-4]\\d{2}|655[0-2]\\d|6553[0-5]))?$"
          },
          {
            "type": "object",
            "properties": {
              "fromSetting": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "fromSetting"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "secrets": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]*[a-z0-9])?(?::(?:[1-9]\\d{0,3}|[1-5]\\d{4}|6[0-4]\\d{3}|65[0-4]\\d{2}|655[0-2]\\d|6553[0-5]))?$"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "fromSetting": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "fromSetting"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "optional": {
                "default": false,
                "type": "boolean"
              },
              "as": {
                "type": "string",
                "const": "bearer"
              }
            },
            "required": [
              "purpose",
              "hosts",
              "as"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]*[a-z0-9])?(?::(?:[1-9]\\d{0,3}|[1-5]\\d{4}|6[0-4]\\d{3}|65[0-4]\\d{2}|655[0-2]\\d|6553[0-5]))?$"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "fromSetting": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "fromSetting"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "optional": {
                "default": false,
                "type": "boolean"
              },
              "as": {
                "type": "string",
                "const": "header"
              },
              "header": {
                "type": "string",
                "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
              },
              "prefix": {
                "type": "string"
              }
            },
            "required": [
              "purpose",
              "hosts",
              "as",
              "header"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]*[a-z0-9])?(?::(?:[1-9]\\d{0,3}|[1-5]\\d{4}|6[0-4]\\d{3}|65[0-4]\\d{2}|655[0-2]\\d|6553[0-5]))?$"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "fromSetting": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "fromSetting"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "optional": {
                "default": false,
                "type": "boolean"
              },
              "as": {
                "type": "string",
                "const": "form"
              },
              "field": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "purpose",
              "hosts",
              "as",
              "field"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "googleScopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https:\\/\\/\\S+$"
      }
    },
    "tokens": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "send"
            ]
          },
          "untrusted": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "risk",
          "untrusted"
        ],
        "additionalProperties": false
      }
    },
    "needs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "process"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 3600000
        },
        "headersTimeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 3600000
        },
        "idleTimeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 3600000
        },
        "maxResponseBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1073741824
        }
      },
      "additionalProperties": false
    },
    "recording": {
      "type": "object",
      "properties": {
        "userContent": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:request|response)\\.body(?:\\.[^.[\\]*\\s]+|\\.\\*|\\[(?:\\*|\\d+)\\])*|request\\.query\\.[^.[\\]*\\s]+)$"
          }
        },
        "secretFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowContentTypes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][\\w!#$&^.+-]*\\/[a-z0-9][\\w!#$&^.+-]*$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "kit",
    "provides",
    "hosts"
  ],
  "additionalProperties": false
}
