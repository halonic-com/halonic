{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "implements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "money",
              "date",
              "month",
              "choice",
              "boolean",
              "ref"
            ]
          },
          "description": {
            "type": "string"
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "collection": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "default": {},
          "compute": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "views": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "where": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "gt": {},
                    "gte": {},
                    "lt": {},
                    "lte": {},
                    "not": {}
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "total": {
            "type": "string"
          },
          "sort": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "seed": {
      "default": [],
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "fields"
  ],
  "additionalProperties": false
}
