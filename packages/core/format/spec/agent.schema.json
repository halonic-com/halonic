{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "params": {
      "default": {},
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "topP": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasoningEffort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "extra": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "instructions": {
      "default": "",
      "type": "string"
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connectors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runLogs": {
      "default": false,
      "type": "boolean"
    },
    "collections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "subagents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "methods": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "input": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "string"
          },
          "maxSteps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "output": {
            "default": "text",
            "anyOf": [
              {
                "type": "string",
                "const": "text"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "list",
                    "object",
                    "string?",
                    "number?",
                    "boolean?",
                    "list?",
                    "object?"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "instructions"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "default": {
        "type": "text"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "choice"
            },
            "options": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "options"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "schema": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "maxSteps": {
      "default": 6,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "character": {
      "type": "object",
      "properties": {
        "style": {
          "default": "buddy",
          "type": "string",
          "const": "buddy"
        },
        "surface": {
          "default": "soft",
          "type": "string",
          "enum": [
            "soft",
            "glossy"
          ]
        },
        "body": {
          "default": "elastic",
          "type": "string",
          "enum": [
            "elastic",
            "firm"
          ]
        },
        "top": {
          "default": "none",
          "type": "string",
          "const": "none"
        },
        "colors": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "string",
      "enum": [
        "halonic",
        "claude-code",
        "codex"
      ]
    },
    "workingFolder": {
      "type": "string"
    },
    "allowedSites": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
