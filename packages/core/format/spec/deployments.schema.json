{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/format/deployments/v1.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "default": {
      "type": "string"
    },
    "deployments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "allOf": [
          {
            "pattern": "^[a-z0-9][a-z0-9-_]*$"
          },
          {
            "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)"
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "host": {
            "default": "local",
            "type": "string",
            "enum": [
              "local",
              "cloudflare"
            ]
          },
          "stage": {
            "default": "development",
            "type": "string",
            "enum": [
              "development",
              "production"
            ]
          },
          "shadow": {
            "default": false,
            "type": "boolean"
          },
          "cloudflare": {
            "type": "object",
            "properties": {
              "worker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "domain": {
                "type": "string",
                "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "location": {
                "type": "string",
                "enum": [
                  "eu"
                ]
              }
            },
            "required": [
              "worker"
            ],
            "additionalProperties": false
          },
          "limits": {
            "type": "object",
            "properties": {
              "dailyRequests": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "deployments"
  ],
  "additionalProperties": false
}
