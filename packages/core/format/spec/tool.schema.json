{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/format/tool/v1.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "action": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "callers": {
      "default": {
        "everyone": false,
        "agents": []
      },
      "type": "object",
      "properties": {
        "everyone": {
          "default": false,
          "type": "boolean"
        },
        "agents": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 48,
        "pattern": "^[a-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "choices": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "required": [
          "type",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "description",
    "action"
  ],
  "additionalProperties": false
}
