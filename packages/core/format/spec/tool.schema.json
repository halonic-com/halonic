{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/format/tool/v1.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "parameters": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "enum": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "maxLength": {
                "default": 1000,
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "integer"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "minimum": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "maximum": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "required": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "description"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "callers": {
      "anyOf": [
        {
          "type": "string",
          "const": "everyone"
        },
        {
          "type": "object",
          "properties": {
            "agents": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          "required": [
            "agents"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "github.pull-request"
            },
            "with": {
              "type": "object",
              "properties": {
                "repositories": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$"
                  }
                }
              },
              "required": [
                "repositories"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "run",
            "with"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "github.open-pull-requests"
            },
            "with": {
              "type": "object",
              "properties": {
                "repositories": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$"
                  }
                }
              },
              "required": [
                "repositories"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "run",
            "with"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "github.merge-queue"
            },
            "with": {
              "type": "object",
              "properties": {
                "repositories": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$"
                  }
                }
              },
              "required": [
                "repositories"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "run",
            "with"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "github.merge-times"
            },
            "with": {
              "type": "object",
              "properties": {
                "repositories": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$"
                  }
                },
                "days": {
                  "default": 7,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 90
                }
              },
              "required": [
                "repositories"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "run",
            "with"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "paperclip.task"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "paperclip.failed-runs"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "hours": {
                  "default": 24,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "paperclip.budgets"
            },
            "with": {
              "type": "object",
              "properties": {
                "agents": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  }
                }
              },
              "required": [
                "agents"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "run",
            "with"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "paperclip.template"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "paperclip.comment"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "mode": {
                  "default": "dry-run",
                  "type": "string",
                  "enum": [
                    "dry-run",
                    "write"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "paperclip.next-step"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "mode": {
                  "default": "dry-run",
                  "type": "string",
                  "enum": [
                    "dry-run",
                    "write"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "paperclip.finish-run"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "mode": {
                  "default": "dry-run",
                  "type": "string",
                  "enum": [
                    "dry-run",
                    "write"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "callers",
    "action"
  ],
  "additionalProperties": false
}
