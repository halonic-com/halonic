{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/format/workspace/v1.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "privacy": {
      "default": {
        "localOnly": false
      },
      "type": "object",
      "properties": {
        "localOnly": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "default": "EUR",
          "type": "string",
          "minLength": 1
        },
        "perRun": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "monthly": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "default": {
        "runtime": "inprocess",
        "model": "default"
      },
      "type": "object",
      "properties": {
        "runtime": {
          "default": "inprocess",
          "type": "string"
        },
        "model": {
          "default": "default",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assistant": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "topP": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "stop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasoningEffort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "extra": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "additionalProperties": false
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "connectors": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "string",
          "enum": [
            "expressive",
            "minimal",
            "off"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
