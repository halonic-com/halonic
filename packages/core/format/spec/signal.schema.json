{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/format/signal/v1.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "pr-watcher"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "done": {
                  "default": true,
                  "type": "boolean"
                },
                "wakeOn": {
                  "default": [
                    "ci-red",
                    "conflict",
                    "retargeted",
                    "review",
                    "approved",
                    "merged",
                    "held"
                  ],
                  "maxItems": 7,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "ci-red",
                      "conflict",
                      "retargeted",
                      "review",
                      "approved",
                      "merged",
                      "held"
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "board-ask"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "windowMinutes": {
                  "default": 12,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "wake": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "task-effort"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "highFrom": {
                  "default": 4,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "highAfterSendBack": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "fast-track"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "reviewEscalateMinutes": {
                  "default": 15,
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 120
                },
                "enqueueAfterMinutes": {
                  "default": 10,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "queueSlowMinutes": {
                  "default": 30,
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 240
                },
                "jumpAhead": {
                  "default": 8,
                  "type": "integer",
                  "minimum": 8,
                  "maximum": 50
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "thin-spec"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "threshold": {
                  "default": 0.5,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "upTo": {
                  "default": 4,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "newForHours": {
                  "default": 24,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                },
                "doneWhen": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "const": "rule-checks"
            },
            "with": {
              "default": {},
              "type": "object",
              "properties": {
                "shortestMonitorMinutes": {
                  "default": 15,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120
                },
                "inProgressLimit": {
                  "default": 10,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        }
      ]
    },
    "dryRun": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "rule"
  ],
  "additionalProperties": false
}
