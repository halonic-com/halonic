          }
        },
        "secretFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowContentTypes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][\\w!#$&^.+-]*\\/[a-z0-9][\\w!#$&^.+-]*$"
