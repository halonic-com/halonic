{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/format/connector/v1.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "transport": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "http": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "http"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stdio": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "secretEnv": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "stdio"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "google": {
              "type": "object",
              "properties": {
                "account": {
                  "type": "string",
                  "format": "email",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                },
                "client": {
                  "default": "google",
                  "type": "string"
                }
              },
              "required": [
                "account"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "google"
          ],
          "additionalProperties": false
        }
      ]
    },
    "secret": {
      "type": "string"
    },
    "tools": {
      "default": {
        "approve": []
      },
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approve": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "local": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "transport"
  ],
  "additionalProperties": false
}
