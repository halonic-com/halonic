{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halonic.com/spec/format/workflow/v1.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "initial": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "context": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "start": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "field"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "default": "task",
            "type": "string",
            "enum": [
              "task",
              "wait",
              "final",
              "workflow",
              "parallel",
              "foreach"
            ]
          },
          "description": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "workflow": {
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            ]
          },
          "gets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(input|context)\\.[^.\\s]+(\\.[^.\\s]+)*$"
            }
          },
          "output": {
            "type": "string"
          },
          "conversation": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "json"
            ]
          },
          "signal": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-_]*$"
          },
          "with": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "items": {
            "type": "string"
          },
          "as": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-_]*$"
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "branches": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "agent": {
                  "type": "string"
                },
                "input": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  ]
                },
                "method": {
                  "type": "string"
                },
                "with": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "agent"
              ],
              "additionalProperties": false
            }
          },
          "join": {
            "type": "string",
            "enum": [
              "all",
              "any"
            ]
          },
          "continueOnError": {
            "type": "boolean"
          },
          "artifact": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "mediaType": {
                "default": "text/markdown",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "on": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9-_]*$"
                },
                "event": {
                  "default": "done",
                  "type": "string"
                },
                "when": {
                  "$ref": "#/$defs/__schema0"
                },
                "after": {
                  "type": "string",
                  "pattern": "^[1-9]\\d*(m|h|d)$"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "to"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "initial",
    "states"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "equals": {
              "type": "array",
              "prefixItems": [
                {},
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "notEquals": {
              "type": "array",
              "prefixItems": [
                {},
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "notEquals"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contains": {
              "type": "array",
              "prefixItems": [
                {},
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "contains"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "exists": {
              "type": "string"
            }
          },
          "required": [
            "exists"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gt": {
              "type": "array",
              "prefixItems": [
                {},
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "gt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gte": {
              "type": "array",
              "prefixItems": [
                {},
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "gte"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lt": {
              "type": "array",
              "prefixItems": [
                {},
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "lt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lte": {
              "type": "array",
              "prefixItems": [
                {},
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "lte"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
