      "build..acme.example",
      "build acme",
      "build;acme",
      "build$(id)",
      "build`id`",
      "build\nacme",
      "ops@build.acme.example",
      "build.acme.example:22",
      "[::1]",
      "build/acme",
      "build'acme"
    ]
  },
  "users": {
