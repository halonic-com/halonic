  "launcher": {
    "target": {
      "host": "build.acme.example",
      "user": "ops",
      "port": 2222
    },
    "task": "HAL-1234",
    "script": [
      "#!/bin/sh",
      "cd -- \"$(dirname -- \"$0\")\" || exit 1",
      "ssh -p 2222 -- 'ops@build.acme.example' 'umask 077 && mkdir -p .halonic/briefs && cat > .halonic/briefs/HAL-1234.md && find .halonic/briefs -maxdepth 1 -type f -name \"HAL-*.md\" -mmin +60 -delete' < ./brief-HAL-1234.md",
      "upload=$?",
      "rm -f -- ./brief-HAL-1234.md ./run-HAL-1234.command ./run-HAL-1234.sh",
      "if [ \"$upload\" -ne 0 ]; then",
      "  echo 'Halonic: the brief could not be copied to the server, so Claude Code was not started.'",
      "  exit 1",
      "fi",
      "exec ssh -t -p 2222 -- 'ops@build.acme.example' 'claude \"Read the file .halonic/briefs/HAL-1234.md and follow it.\"; rm -f .halonic/briefs/HAL-1234.md'",
      ""
    ]
  }
}
