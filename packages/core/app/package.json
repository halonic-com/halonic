{
  "name": "@halonicjs/app",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "The headless app kernel: command bus, event bus, service registry, workspace-wide undo and the routine scheduler service. No React.",
  "exports": {
    ".": "./src/index.ts",
    "./failed-call": "./src/failed-call.ts",
    "./listed-tools": "./src/listed-tools.ts",
    "./model-choice": "./src/model-choice.ts",
    "./model-choice-service": "./src/model-choice-service.ts",
    "./outside-run": "./src/outside-run-gate.ts",
    "./routines": "./src/routines.ts",
    "./run-failure": "./src/run-failure.ts",
    "./saved-local-only": "./src/saved-local-only.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/events": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/routines": "workspace:*",
    "@halonicjs/std": "workspace:*",
    "@halonicjs/workspace": "workspace:*",
    "@halonicjs/yaml": "workspace:*"
  },
  "devDependencies": {
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "core",
    "owner": "liam",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
