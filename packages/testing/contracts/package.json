{
  "name": "@halonicjs/testing-contracts",
  "private": true,
  "type": "module",
  "description": "One contract suite per port. Every adapter for a port runs its suite, so all adapters behave the same (plan 4.3).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/events": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@halonicjs/std": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "testing",
    "owner": "julian",
    "coverage": {
      "lines": 90,
      "branches": 85,
      "measuredIn": "@halonicjs/adapter-memory"
    }
  }
}
