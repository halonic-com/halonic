{
  "name": "@halonicjs/testing-integration",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The conformance suite every integration runs against recorded responses, with its attack cases: an undeclared host, a file or a leaked key must fail. Published for the integrations repo.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build": "node ../../../tooling/publish/src/cli/stage.ts ."
  },
  "dependencies": {
    "@halonicjs/adapter-integration-kit": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/schema-kit": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@halonicjs/tooling-publish": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "testing",
    "owner": "liam",
    "coverage": {
      "lines": 90,
      "branches": 85
    },
    "publish": {
      "name": "@halonicjs/testing-integration",
      "aliases": {
        "@halonicjs/adapter-integration-kit/integration": "@halonicjs/integration-kit"
      },
      "dependencies": {
        "@halonicjs/integration-kit": "0.1.0",
        "zod": "4.6.7"
      },
      "peerDependencies": {
        "vitest": "^5.1.0"
      }
    }
  }
}
