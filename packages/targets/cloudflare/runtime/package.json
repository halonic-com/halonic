{
  "name": "@halonicjs/target-cloudflare-runtime",
  "private": true,
  "type": "module",
  "description": "The Halonic Worker on Cloudflare: fetch() and scheduled(), the Durable Object classes and the wiring of the Cloudflare adapters.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.wiring.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@halonicjs/adapter-cloudflare-durable": "workspace:*",
    "@halonicjs/adapter-cloudflare-storage": "workspace:*",
    "@halonicjs/adapter-env-secrets": "workspace:*",
    "@halonicjs/adapter-password-pbkdf2": "workspace:*",
    "@halonicjs/adapter-token-store": "workspace:*",
    "@halonicjs/host-server": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/std": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@halonicjs/target-cloudflare-testing": "workspace:*",
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "targets",
    "owner": "priya",
    "coverage": {
      "lines": 90,
      "branches": 85
    }
  }
}
