{
  "//": "The code that runs inside workerd, checked against workerd's own types: no Node types.",
  "extends": "@halonicjs/tooling-config/tsconfig/base.json",
  "compilerOptions": {
    "lib": [
      "es2024"
    ],
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src/worker"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
