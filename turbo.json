{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tooling/config/tsconfig/**",
    "tooling/config/types/**",
    "tooling/config/biome.jsonc",
    "tooling/config/src/vitest-preset.ts",
    "tooling/config/src/coverage.ts",
    "tooling/config/src/fast-check-seed.ts",
    "tooling/config/src/fast-check-setup.ts",
    "biome.json"
  ],
  "tasks": {
    "//#codegen": {
      "inputs": [
        "apps/*/package.json",
        "packages/studio/features/*/package.json",
        "packages/studio/features/*/src/feature.ts",
        "tooling/discover/src/**",
        "tooling/check/src/**",
        "apps/cli/package.json",
        "apps/cli/src/commands/*/command.ts"
      ],
      "outputs": [
        "apps/studio/src/generated/**",
        "apps/cli/src/generated/commands.ts"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "//#codegen",
        "transit"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "//#codegen",
        "transit"
      ],
      "env": [
        "FAST_CHECK_SEED"
      ],
      "outputs": [
        "test-results/**"
      ]
    },
    "build": {
      "dependsOn": [
        "//#codegen",
        "^build",
        "transit"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
