{
  "name": "@halonicjs/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "verify": "node tooling/check/src/cli/verify.ts",
    "check": "node tooling/check/src/cli/check.ts",
    "check:terms": "node tooling/check/src/cli/terms.ts",
    "check:pr-title": "node tooling/check/src/cli/pr-title.ts",
    "discover": "node tooling/discover/src/cli/discover.ts",
    "new": "node tooling/discover/src/cli/new.ts",
    "format": "biome format --write .",
    "ci:all": "turbo run typecheck lint test build --continue",
    "ci:fast": "pnpm check && biome ci --linter-enabled=false . && pnpm discover --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:"
  },
  "halonic": {
    "layer": "tooling",
    "owner": "mateo"
  }
}
