#!/bin/sh
# Refuses a push whose commits add a secret or key, a private key block, an
# .env or key file, an absolute local path or a personal term, also in a
# commit message, author or committer.
# Installed by `pnpm install`; see docs/guides/leak-guard.md.
. "$(dirname "$0")/run-leak-guard.sh"
exec "$node" "$hooks_dir/../src/cli/leaks.ts" --push "$1"
