{
  "name": "@halonicjs/tooling-paperclip",
  "private": true,
  "type": "module",
  "description": "Tools that run beside Paperclip without a model: the Agent tools plugin with its PR watcher, and the reviewer path list.",
  "exports": {
    ".": "./src/index.ts",
    "./routing": "./src/routing-load.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build:plugin": "node src/plugin/build.ts",
    "build:seats-plugin": "node src/seats/plugin/build.ts",
    "build:gh-guard": "node src/gh-guard/build.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "devDependencies": {
    "@halonicjs/app": "workspace:*",
    "@halonicjs/engine": "workspace:*",
    "@halonicjs/events": "workspace:*",
    "@halonicjs/format": "workspace:*",
    "@halonicjs/ports": "workspace:*",
    "@halonicjs/retry-detectors": "workspace:*",
    "@halonicjs/std": "workspace:*",
    "@halonicjs/target-paperclip-runtime": "workspace:*",
    "@halonicjs/testing-contracts": "workspace:*",
    "@halonicjs/testing-spec": "workspace:*",
    "@halonicjs/tooling-config": "workspace:*",
    "@paperclipai/plugin-sdk": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/typescript6": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "tooling",
    "owner": "mateo",
    "coverage": {
      "lines": 80
    }
  }
}
