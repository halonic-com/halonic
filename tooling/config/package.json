{
  "name": "@halonicjs/tooling-config",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript presets, Biome config and the Vitest preset with coverage floors.",
  "exports": {
    "./vitest": "./src/vitest-preset.ts",
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./biome.jsonc": "./biome.jsonc"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "halonic": {
    "layer": "tooling",
    "owner": "mateo",
    "coverage": {
      "lines": 80
    }
  }
}
