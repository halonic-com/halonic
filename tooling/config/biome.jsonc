{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "json": {
    // Expanded like JSON.stringify(value, null, 2), the way pnpm, `pnpm new`
    // and `pnpm discover --fix` write package.json, so their output is
    // already formatted.
    "formatter": {
      "expand": "always"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        // Sorted imports: `biome check` (every package's lint, and CI) fails on an unsorted block.
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "noNestedTernary": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        // Skipped and focused tests also fail the requirement guard.
        "noSkippedTests": "error",
        "noFocusedTests": "error"
      },
      "complexity": {
        // TypeScript's noPropertyAccessFromIndexSignature requires
        // record["key"] for index signatures; this rule would undo that.
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "correctness": {
        "useImportExtensions": "error"
      },
      "performance": {
        // Each package has one explicit public index.ts with named re-exports; only `export *` is banned.
        "noReExportAll": "error"
      }
    }
  },
  // Layer rules, from AGENTS.md. Biome reads these globs relative to the package's own
  // biome.json when it has one, so packages/studio/kit/biome.json repeats the Studio rules.
  // Approved libraries per package stay in tooling/check/dependencies.json, checked by `pnpm check`.
  "overrides": [
    {
      // Studio CSS entries set Tailwind up (@source, @custom-variant), like the shell's e2e pages.
      "includes": [
        "**/packages/studio/**/*.css"
      ],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    },
    {
      "includes": [
        "**/vitest.config.ts",
        "**/vitest.fence.config.ts",
        "**/vite.config.ts",
        "**/playwright.config.ts",
        "**/astro.config.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/core/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**"
                    ],
                    "message": "Node APIs belong in Node adapters, the Node target and deploy packages. Use a port."
                  },
                  {
                    "group": [
                      "@halonicjs/adapter-*",
                      "@halonicjs/adapter-*/**"
                    ],
                    "message": "Adapters are for adapters and apps. Use a port from core."
                  },
                  {
                    "group": [
                      "@halonicjs/studio-*",
                      "@halonicjs/studio-*/**"
                    ],
                    "message": "Only Studio packages and apps may use Studio packages."
                  },
                  {
                    "group": [
                      "@halonicjs/host",
                      "@halonicjs/host-*"
                    ],
                    "message": "Core never uses the host."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/core/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/test/**",
        "!**/packages/core/yaml/**",
        "!**/packages/core/schema-kit/**",
        "!**/packages/core/format/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**"
                    ],
                    "message": "Node APIs belong in Node adapters, the Node target and deploy packages. Use a port."
                  },
                  {
                    "group": [
                      "@halonicjs/adapter-*",
                      "@halonicjs/adapter-*/**"
                    ],
                    "message": "Adapters are for adapters and apps. Use a port from core."
                  },
                  {
                    "group": [
                      "@halonicjs/studio-*",
                      "@halonicjs/studio-*/**"
                    ],
                    "message": "Only Studio packages and apps may use Studio packages."
                  },
                  {
                    "group": [
                      "@halonicjs/host",
                      "@halonicjs/host-*"
                    ],
                    "message": "Core never uses the host."
                  },
                  {
                    "group": [
                      "**",
                      "!@halonicjs/**",
                      "!./**",
                      "!../**",
                      "!node:*",
                      "!node:*/**"
                    ],
                    "message": "No outside libraries here. Only code that talks to the outside world may use one (tooling/check/dependencies.json)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/host/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**"
                    ],
                    "message": "Node APIs belong in Node adapters, the Node target and deploy packages. Use a port."
                  },
                  {
                    "group": [
                      "@halonicjs/adapter-*",
                      "@halonicjs/adapter-*/**"
                    ],
                    "message": "Adapters are for adapters and apps. Use a port from core."
                  },
                  {
                    "group": [
                      "@halonicjs/studio-*",
                      "@halonicjs/studio-*/**"
                    ],
                    "message": "Only Studio packages and apps may use Studio packages."
                  },
                  {
                    "group": [
                      "**",
                      "!@halonicjs/**",
                      "!./**",
                      "!../**",
                      "!node:*",
                      "!node:*/**"
                    ],
                    "message": "No outside libraries here. Only code that talks to the outside world may use one (tooling/check/dependencies.json)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/adapters/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@halonicjs/studio-*",
                      "@halonicjs/studio-*/**"
                    ],
                    "message": "Only Studio packages and apps may use Studio packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/studio/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**"
                    ],
                    "message": "Node APIs belong in Node adapters, the Node target and deploy packages. Use a port."
                  },
                  {
                    "group": [
                      "@halonicjs/adapter-*",
                      "@halonicjs/adapter-*/**"
                    ],
                    "message": "Adapters are for adapters and apps. Use a port from core."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/studio/services/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**"
                    ],
                    "message": "Node APIs belong in Node adapters, the Node target and deploy packages. Use a port."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/adapters/integration-kit/src/limited-http.ts",
        "**/packages/adapters/integration-kit/src/response-body.ts",
        "**/packages/core/app/src/listed-tool-rules.ts",
        "**/packages/core/app/src/tool-call-check.ts",
        "**/packages/core/std/src/posix-path.ts",
        "**/packages/core/yaml/src/edit.ts",
        "**/packages/testing/parity/src/allowed-differences.test.ts",
        "**/tooling/check/src/cli/leaks.ts",
        "**/tooling/check/src/guard/guard.ts",
        "**/tooling/check/src/leaks/git-changes.ts",
        "**/tooling/check/src/lib/catalog.ts",
        "**/tooling/check/src/lib/requirements.ts",
        "**/tooling/check/src/lib/source-files.ts",
        "**/tooling/check/src/lib/trace-model.ts",
        "**/tooling/check/src/lib/workspace.ts",
        "**/tooling/check/src/rules/agents-md.ts",
        "**/tooling/check/src/rules/file-size.ts",
        "**/tooling/check/src/rules/invisible-characters.ts",
        "**/tooling/check/src/rules/packages.ts",
        "**/tooling/check/src/rules/readme-examples.ts",
        "**/tooling/discover/src/cli/new.ts",
        "**/tooling/mutation/src/score.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 30
              }
            }
          }
        }
      }
    }
  ]
}
