node_modules/
.turbo/
dist/
coverage/
test-results/
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example

# Generated by tooling/discover before every build, test and dev run.
**/src/generated/

# Written by tooling/publish while a package builds, then removed. Ignored so
# a lint running at the same time doesn't check it.
tsconfig.stage-*.json

# Rust build output. Only target/: Tauri keeps generated sources in gen/.
apps/studio/src-tauri/target/

# Generated by tauri-build on every build: the capability schemas for editors.
apps/studio/src-tauri/gen/schemas/

# The agent host, copied here by windows/build-installer.ps1 for the installer.
apps/studio/src-tauri/binaries/

# The release notices and SBOM, written by windows/build-installer.ps1.
apps/studio/src-tauri/legal/
